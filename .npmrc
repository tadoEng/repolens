# Fail the install when the local Node version does not satisfy `engines.node`,
# rather than failing later with an obscure runtime error.
engine-strict=true

# Peer mismatches fail the install. A blanket escape hatch would also absorb the
# next mismatch — the one that actually matters — so known-inert exceptions are
# listed individually under `pnpm.peerDependencyRules` in package.json, where
# each one has to state which package and which version it forgives.
strict-peer-dependencies=true
