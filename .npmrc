# Fail the install when the local Node version does not satisfy `engines.node`,
# rather than failing later with an obscure runtime error.
engine-strict=true

# Peer ranges across the Svelte/Vite/Vitest ecosystem move faster than their
# published peer metadata. The workspace pins the real versions explicitly, so a
# peer mismatch is a warning to investigate, not an install failure.
strict-peer-dependencies=false
