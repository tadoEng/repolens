# Fail the install when the local Node version does not satisfy `engines.node`,
# rather than failing later with an obscure runtime error.
engine-strict=true

# Peer-dependency strictness lives in pnpm-workspace.yaml, not here.
#
# `strict-peer-dependencies` is a pnpm-only setting, and npm reads this file too:
# every `npm`/`npx` invocation in this directory printed
#   npm warn Unknown project config "strict-peer-dependencies"
#   This will stop working in the next major version of npm
# which is noise on every unrelated command, and a warning that npm intends to
# turn into an error. pnpm 11 moved its settings to pnpm-workspace.yaml anyway,
# so that is now the single home for them.
#
# `engine-strict` stays: npm and pnpm both understand it natively.
