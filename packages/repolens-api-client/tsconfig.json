{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Node types are needed by the staleness gate (schema.test.ts reads files and runs
    // openapi-typescript). The shipped runtime — client.ts — deliberately touches no Node
    // API and no Svelte API: it is a contract package consumed by a browser bundle.
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "*.ts"]
}
