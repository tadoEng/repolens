# Local configuration and secrets.
# Real values live in .env.local (project-scoped, never machine-wide env vars).
# Only .env.example — with empty values — is ever committed.
.env
.env.*
!.env.example

# Build output
target/
node_modules/
.svelte-kit/
build/
dist/

# Test artefacts
test-results/
web/.vitest-attachments/
web/src/tests/__screenshots__/
playwright-report/
blob-report/
web/test-results/
web/playwright-report/

# Credential material. Never committed; rotate at the provider if one ever leaks.
*.pem
*.key
*service-account*.json
gha-creds-*.json

# OS noise
.DS_Store
Thumbs.db

# Deliberately NOT ignored — both must be committed:
#   Cargo.lock  application build reproducibility (this workspace ships binaries,
#               not a published library, so the lockfile is part of the contract)
#   .sqlx/      SQLx offline query cache; without it, Docker and CI builds fail
#               confusingly because `sqlx::query!` cannot reach a live database

# Vendored agent skills, installed by provider CLIs (e.g. `neon init`) and
# regenerable from skills-lock.json. Duplicated across .agents/ and .claude/,
# and third-party content that would distort RepoLens's analysis of itself.
# Scoped to skills/ so a genuine .claude/settings.json can still be committed.
.agents/
.claude/skills/
# Agent worktrees are separate checkouts of this repository; committing them
# would embed a repo inside itself.
.claude/worktrees/
skills-lock.json
