# RepoLens environment template.
#
# This file is committed and MUST stay empty on the right-hand side.
# Real values belong in .env.local, which is git-ignored and never committed,
# never pasted into issues, pull requests, CI logs, or chat.
# A credential that appears anywhere public is rotated at the provider —
# deleting it does not un-disclose it.

# --- Secret: never leaves .env.local / Secret Manager / Actions secrets ---

# Neon pooled endpoint. API and ordinary worker transactions.
DATABASE_URL=
# Neon direct endpoint. Migrations and session-dependent administration.
DATABASE_DIRECT_URL=
# GitHub token used for analysis ingestion (read-only, public repositories).
GH_ANALYSIS_TOKEN=

# --- Public by design: the Firebase web config identifies the project but
# --- authorizes nothing on its own, provided the browser key stays restricted
# --- to Firebase APIs. SvelteKit's PUBLIC_ prefix makes that boundary enforced
# --- rather than conventional. No measurementId: Analytics is not adopted.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
